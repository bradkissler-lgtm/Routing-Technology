// Data model for the commercial equipment finance platform.
// See /docs/blueprint.md for the full reasoning — this schema implements
// the corrected participant model and application lifecycle from the
// developer-ready blueprint (Foundation §1.3-1.4, Pilot Spec §2.2).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenant root
// ---------------------------------------------------------------------------

model Manufacturer {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dealers              Dealer[]
  financingPrograms    FinancingProgram[]
  businessApplicants   BusinessApplicant[]
  individualApplicants IndividualApplicant[]
  applications         Application[]
  auditLogEntries      AuditLogEntry[]
  dataRetentionEvents  DataRetentionEvent[]
  users                User[]

  @@map("manufacturers")
}

// ---------------------------------------------------------------------------
// Auth (added to close the "no authentication" gap noted throughout
// docs/blueprint.md — see "Known limitations"). Two roles, matching the two
// access levels the blueprint already defines: DEALER (scoped to exactly
// one Dealer — can operate that dealer's intake and lifecycle screens,
// never another dealer's) and MANUFACTURER (whole-tenant, aggregate-only —
// never sees Guarantor/individual PII, matching the existing manufacturer
// dashboard's query shape). Phase 1 auth: email + password (bcrypt-hashed,
// never plaintext), JWT sessions via next-auth. No SSO, no password reset,
// no MFA, no rate limiting on login attempts — those are real gaps for a
// production pilot beyond this Phase 1 scope, not oversights; see
// docs/blueprint.md.
// ---------------------------------------------------------------------------

enum UserRole {
  DEALER
  MANUFACTURER
}

model User {
  id             String   @id @default(cuid())
  manufacturerId String
  email          String   @unique
  passwordHash   String
  role           UserRole
  dealerId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  manufacturer Manufacturer @relation(fields: [manufacturerId], references: [id])
  dealer       Dealer?      @relation(fields: [dealerId], references: [id])

  @@map("users")
}

// ---------------------------------------------------------------------------
// Dealer network
// ---------------------------------------------------------------------------

model Dealer {
  id             String   @id @default(cuid())
  manufacturerId String
  name           String
  code           String
  contactEmail   String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  manufacturer Manufacturer  @relation(fields: [manufacturerId], references: [id])
  applications Application[]
  users        User[]

  @@unique([manufacturerId, code])
  @@map("dealers")
}

// ---------------------------------------------------------------------------
// Lenders and their financing programs — kept as separate entities per
// Blueprint §1.4: a Lender may run several Programs, and a Program may be
// captive or third-party. Reporting on "which program approves what"
// requires them not to be conflated.
// ---------------------------------------------------------------------------

model Lender {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  programs FinancingProgram[]

  @@map("lenders")
}

enum FinancingProgramType {
  CAPTIVE
  THIRD_PARTY
}

model FinancingProgram {
  id             String               @id @default(cuid())
  manufacturerId String
  lenderId       String
  name           String
  type           FinancingProgramType
  isActive       Boolean              @default(true)
  // Rare: most programs have no score threshold and leave this null, so no
  // bureau pull happens before submission — the lender pulls credit on
  // their own systems after receiving the routed application (Blueprint
  // §1.4/§2.1's default posture). When a program's own eligibility rule
  // requires knowing the applicant's/guarantor's FICO score to decide
  // whether to even route to it, this is set, and BureauPull below records
  // the platform-initiated pull that rule requires (updated 2026-09-06).
  minFicoScore   Int?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  manufacturer Manufacturer       @relation(fields: [manufacturerId], references: [id])
  lender       Lender             @relation(fields: [lenderId], references: [id])
  submissions  LenderSubmission[]
  bureauPulls  BureauPull[]

  @@map("financing_programs")
}

// ---------------------------------------------------------------------------
// Business applicants — Phase 1 primary applicant type (Blueprint §1.4).
// Business financial data is NOT a "consumer report" under FCRA (the
// business is not a "consumer"); ordinary commercial data-sharing terms
// govern it, not FCRA. See /docs/blueprint.md §1.3.
// ---------------------------------------------------------------------------

model BusinessApplicant {
  id             String   @id @default(cuid())
  manufacturerId String
  legalName      String
  ein            String?
  addressLine1   String
  city           String
  state          String
  postalCode     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  manufacturer Manufacturer  @relation(fields: [manufacturerId], references: [id])
  owners       Owner[]
  applications Application[]

  @@index([manufacturerId, legalName])
  @@map("business_applicants")
}

// A person with equity or control in a BusinessApplicant. May or may not
// also be a Guarantor on any given application — tracked separately, never
// assumed (Blueprint §1.4). Not a consumer-report subject by itself; only
// becomes one if also captured as a Guarantor who is credit-pulled.
model Owner {
  id                  String   @id @default(cuid())
  businessApplicantId String
  firstName           String
  lastName            String
  title               String?
  ownershipPercent    Decimal? @db.Decimal(5, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  businessApplicant BusinessApplicant @relation(fields: [businessApplicantId], references: [id])
  guarantorLinks    Guarantor[]

  @@map("owners")
}

// ---------------------------------------------------------------------------
// Individual applicants — consumer financing, ships alongside commercial in
// V1 (updated 2026-09-06; originally modeled schema-only for a later phase,
// that deferral is superseded — see /docs/blueprint.md).
//
// Unlike a BusinessApplicant, an IndividualApplicant IS credit-pulled
// directly — the applicant themselves, not just an optional guarantor/
// co-signer — so ssnLast4 carries the same FCRA/consumer-report caveat as
// Guarantor.ssnLast4 above: only the last 4 digits are stored; a live
// deployment must route a full SSN through a PCI/GLBA-compliant vault, not
// this table. Consent (including the required credit-pull authorization)
// is recorded via ConsentRecord with participantType INDIVIDUAL, mirroring
// how BusinessApplicant consent works — no separate consent fields here.
// ---------------------------------------------------------------------------

model IndividualApplicant {
  id             String   @id @default(cuid())
  manufacturerId String
  firstName      String
  lastName       String
  email          String
  phone          String
  addressLine1   String
  city           String
  state          String
  postalCode     String
  ssnLast4       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  manufacturer Manufacturer  @relation(fields: [manufacturerId], references: [id])
  applications Application[]

  @@index([manufacturerId, email])
  @@map("individual_applicants")
}

// ---------------------------------------------------------------------------
// Guarantors — a person (rarely another entity) personally guaranteeing the
// obligation on ONE application. Distinct from Owner even when it's the
// same individual (optional link via ownerId, never assumed).
//
// PRODUCTION NOTE (Blueprint §1.3 field-level matrix): a Guarantor's SSN and
// credit report/score ARE consumer-report-adjacent data under FCRA once a
// lender pulls credit on them. Only ssnLast4 is stored here; a live
// deployment must not persist a full SSN or raw bureau report in this
// table. Route those through a PCI/GLBA-compliant vault or tokenization
// service and store only a reference. Retention for this entire model must
// follow the disposal schedule in the data-rights matrix, NOT the
// "permanent" retention that applies to the audit trail — see
// DataRetentionEvent below.
// ---------------------------------------------------------------------------

model Guarantor {
  id            String  @id @default(cuid())
  applicationId String
  ownerId       String?
  firstName     String
  lastName      String
  addressLine1  String
  city          String
  state         String
  postalCode    String
  ssnLast4      String

  consentCreditPull  Boolean   @default(false)
  consentDataSharing Boolean   @default(false)
  consentRecordedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id])
  owner       Owner?      @relation(fields: [ownerId], references: [id])

  @@map("guarantors")
}

// ---------------------------------------------------------------------------
// Consent — one record per participant per purpose, never one blanket
// consent per application (Blueprint §2.1: a business-level consent does
// not cover an individual guarantor's separate authorization).
// participantType/participantId form a lightweight polymorphic reference
// (Prisma has no native polymorphic relation) to whichever participant
// granted this consent: BUSINESS -> BusinessApplicant.id,
// GUARANTOR -> Guarantor.id, INDIVIDUAL -> IndividualApplicant.id.
// ---------------------------------------------------------------------------

enum ConsentParticipantType {
  BUSINESS
  GUARANTOR
  INDIVIDUAL
}

enum ConsentPurpose {
  CREDIT_PULL
  DATA_SHARING
  MARKETING
}

model ConsentRecord {
  id              String                 @id @default(cuid())
  applicationId   String
  participantType ConsentParticipantType
  participantId   String
  purpose         ConsentPurpose
  granted         Boolean
  recordedAt      DateTime               @default(now())

  application Application @relation(fields: [applicationId], references: [id])

  @@index([applicationId, participantType, participantId])
  @@map("consent_records")
}

// ---------------------------------------------------------------------------
// Application lifecycle (Blueprint §1.3 / §2.2):
//   Application -> LenderSubmission(s) -> Decision -> AcceptedOffer -> FundedTransaction
// Approval rate, volume, and time-to-decision MUST be computed at the
// Application level using AcceptedOffer/FundedTransaction as the success
// criterion — never by counting individual LenderSubmission decisions,
// which distorts these figures whenever a cascade is used.
// ---------------------------------------------------------------------------

enum ApplicantType {
  BUSINESS
  INDIVIDUAL
}

// Derived/reporting status, kept as a stored field for query performance and
// updated by application code as the lifecycle chain below changes. See
// /docs/blueprint.md §1.7 for PENDING_RECONCILIATION's purpose: an
// application that hasn't reached a confirmed final disposition must carry
// an explicit "unknown" status, never be silently dropped from reporting.
enum ApplicationStatus {
  SUBMITTED
  IN_PROGRESS
  ACCEPTED
  FUNDED
  CLOSED_LOST
  PENDING_RECONCILIATION
}

model Application {
  id                    String            @id @default(cuid())
  manufacturerId        String
  dealerId              String
  applicantType         ApplicantType
  businessApplicantId   String?
  individualApplicantId String?
  equipmentDescription  String
  requestedAmount       Decimal           @db.Decimal(12, 2)
  status                ApplicationStatus @default(SUBMITTED)
  needsReconciliation   Boolean           @default(false)
  submittedAt           DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  manufacturer        Manufacturer         @relation(fields: [manufacturerId], references: [id])
  dealer              Dealer               @relation(fields: [dealerId], references: [id])
  businessApplicant   BusinessApplicant?   @relation(fields: [businessApplicantId], references: [id])
  individualApplicant IndividualApplicant? @relation(fields: [individualApplicantId], references: [id])
  guarantors          Guarantor[]
  consentRecords      ConsentRecord[]
  lenderSubmissions   LenderSubmission[]
  bureauPulls         BureauPull[]
  acceptedOffer       AcceptedOffer?

  @@index([manufacturerId, dealerId])
  @@index([manufacturerId, status])
  @@map("applications")
}

// One attempt to a specific Lender's Program. A cascade produces several
// per Application. Each LenderSubmission has exactly one Decision.
enum LenderSubmissionStatus {
  SUBMITTED
  DECISIONED
}

model LenderSubmission {
  id                 String                 @id @default(cuid())
  applicationId      String
  financingProgramId String
  status             LenderSubmissionStatus @default(SUBMITTED)
  submittedAt        DateTime               @default(now())
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  application      Application      @relation(fields: [applicationId], references: [id])
  financingProgram FinancingProgram @relation(fields: [financingProgramId], references: [id])
  decision         Decision?

  @@index([applicationId])
  @@map("lender_submissions")
}

// One lender's response to one submission. Phase 1 has no live lender API
// or bureau pull — every Decision here is manually entered by a dealer or
// platform operator (Blueprint §2.1, §2.4). `enteredBy` is a free-text
// identifier for now since Phase 1 has no auth; replace with a real user
// reference once auth exists.
enum DecisionOutcome {
  APPROVED
  DECLINED
  COUNTERED
}

model Decision {
  id                 String          @id @default(cuid())
  lenderSubmissionId String          @unique
  outcome            DecisionOutcome
  reasonCode         String
  reasonText         String
  termsJson          Json?
  enteredBy          String
  decidedAt          DateTime        @default(now())

  lenderSubmission LenderSubmission @relation(fields: [lenderSubmissionId], references: [id])
  acceptedOffer    AcceptedOffer?

  @@map("decisions")
}

// ---------------------------------------------------------------------------
// Bureau pulls — the one exception to "the platform never pulls a credit
// bureau itself" (Blueprint §2.1/§2.2 default posture, corrected
// 2026-09-06). In the ordinary case, a lender pulls credit on their own
// systems after receiving a routed LenderSubmission, and this schema never
// models that pull directly — only their eventual Decision. But some
// programs' own routing/eligibility rules require knowing a FICO score
// BEFORE deciding whether to even submit to them (FinancingProgram.
// minFicoScore, when set) — a rare case, but one where the platform itself
// becomes the one requesting the report, not the lender. That makes the
// platform operator a "user" of consumer reports under FCRA for this
// specific action, with its own permissible-purpose basis (the applicant's
// or guarantor's CREDIT_PULL consent, recorded the same as it is for a
// lender's downstream pull) — see /docs/blueprint.md and confirm this is in
// scope for the recurring legal review before relying on it with real
// applicant data. Only a Guarantor or an IndividualApplicant can be the
// subject here (participantType), never a BusinessApplicant — a business is
// never a consumer-report subject. Phase 1 has no live bureau API; this is
// a manual record of a pull performed outside this system, same pattern as
// Decision.enteredBy.
// ---------------------------------------------------------------------------

enum CreditBureau {
  EQUIFAX
  EXPERIAN
  TRANSUNION
}

model BureauPull {
  id                 String                 @id @default(cuid())
  applicationId      String
  participantType    ConsentParticipantType
  participantId      String
  financingProgramId String?
  bureau             CreditBureau
  ficoScore          Int?
  pulledBy           String
  pulledAt           DateTime               @default(now())

  application      Application       @relation(fields: [applicationId], references: [id])
  financingProgram FinancingProgram? @relation(fields: [financingProgramId], references: [id])

  @@index([applicationId])
  @@map("bureau_pulls")
}

// The single offer the applicant chose, if any. One-to-one with
// Application: an application has zero-or-one accepted offer.
model AcceptedOffer {
  id            String   @id @default(cuid())
  applicationId String   @unique
  decisionId    String   @unique
  acceptedAt    DateTime @default(now())

  application       Application        @relation(fields: [applicationId], references: [id])
  decision          Decision           @relation(fields: [decisionId], references: [id])
  fundedTransaction FundedTransaction?

  @@map("accepted_offers")
}

// Confirms money actually moved — the real "done" state for approval-rate
// and volume reporting (Blueprint §1.3).
model FundedTransaction {
  id              String   @id @default(cuid())
  acceptedOfferId String   @unique
  fundedAmount    Decimal  @db.Decimal(12, 2)
  fundedAt        DateTime @default(now())

  acceptedOffer AcceptedOffer @relation(fields: [acceptedOfferId], references: [id])

  @@map("funded_transactions")
}

// ---------------------------------------------------------------------------
// Audit log — append-only. Every mutation to an application or a
// participant record writes one row here. Never update or delete rows in
// this table from application code. References sensitive records rather
// than embedding them, so a payload can be purged (see DataRetentionEvent)
// without breaking the audit history (Blueprint §1.3).
// ---------------------------------------------------------------------------

model AuditLogEntry {
  id             String   @id @default(cuid())
  manufacturerId String
  entityType     String
  entityId       String
  action         String
  actorType      String
  actorId        String?
  payloadJson    Json?
  createdAt      DateTime @default(now())

  manufacturer Manufacturer @relation(fields: [manufacturerId], references: [id])

  @@index([manufacturerId, entityType, entityId])
  @@map("audit_log_entries")
}

// Records a purge/tokenization action taken against a sensitive payload
// (e.g., a Guarantor's stored fields past their retention window).
// Referenced by the audit log rather than replacing it, so the fact that a
// decision happened remains permanent even after the sensitive payload
// behind it is gone (Blueprint §1.3 — "immutable" is not the same as
// "permanent retention of sensitive payloads").
model DataRetentionEvent {
  id             String   @id @default(cuid())
  manufacturerId String
  entityType     String
  entityId       String
  fieldName      String
  action         String
  note           String?
  performedAt    DateTime @default(now())

  manufacturer Manufacturer @relation(fields: [manufacturerId], references: [id])

  @@index([manufacturerId, entityType, entityId])
  @@map("data_retention_events")
}
