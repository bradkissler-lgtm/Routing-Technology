# Copy this file to .env and fill in real values for local development.
# Never commit the actual .env file — it's gitignored.

# Postgres connection string. If you don't have a local Postgres, the
# fastest path is: docker compose up -d (see docker-compose.yml).
DATABASE_URL="postgresql://app:app@localhost:5432/commercial_equipment_finance"

# Phase 1 is single-tenant: every request resolves to the manufacturer with
# this slug (seeded by prisma/seed.ts). Multi-manufacturer tenancy is a
# later phase — see docs/blueprint.md, "Confirmed Operating Parameters."
DEMO_MANUFACTURER_SLUG="demo-manufacturer"

# Session-signing secret for next-auth (Auth.js). Generate your own with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-base64-string"
