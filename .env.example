# Copy this file to .env and fill in real values for local development.
# Never commit the actual .env file — it's gitignored.

# Postgres connection string. If you don't have a local Postgres, the
# fastest path is: docker compose up -d (see docker-compose.yml).
DATABASE_URL="postgresql://app:app@localhost:5432/dealer_credit_platform"

# MVP is single-tenant: every request resolves to the manufacturer with this
# slug (seeded by prisma/seed.ts). Multi-manufacturer tenancy is a V2 item —
# see docs/architecture.md.
DEMO_MANUFACTURER_SLUG="demo-manufacturer"
